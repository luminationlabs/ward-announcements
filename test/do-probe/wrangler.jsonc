{
  // The Durable Object driver probe (probe.ts), for test/do-driver.test.js. Local only — `wrangler
  // dev` simulates the Durable Objects; nothing here is ever deployed.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ward-do-probe",
  "main": "probe.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "PROBE", "class_name": "ProbeDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProbeDO"] }]
}
