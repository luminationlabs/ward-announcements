{
  // The many-ward host (src/host.ts) for `npm run test:host`: a registry, one SQLite Durable Object
  // per ward, images in each ward's own database. Local only — `wrangler dev` simulates the Durable
  // Objects; nothing here is ever deployed, and it shares nothing with any real deployment.
  // The harness registers 127.0.0.1 as a ward after start (test/helpers/harness.js).
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ward-host-test",
  "main": "../src/host.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "../public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [
      { "name": "WARD", "class_name": "WardDO" },
      { "name": "REGISTRY", "class_name": "RegistryDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WardDO", "RegistryDO"] }],
  "triggers": { "crons": ["0 * * * *"] },
  // The suites sign in as each ward's owner, which a production host leaves off (src/host.ts).
  // The seal key is generated per run by test/helpers/harness.js (TEST_SEAL_KEY), not kept here.
  "vars": { "NODE_ENV": "development", "WARD_OWNER_SIGNIN": "on" }
}
