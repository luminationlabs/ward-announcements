# Copy to .env and fill in. The Node entry's settings; the Workers ones are wrangler.jsonc + .dev.vars.

# --- App identity (all required) ---
# Shown to members and used for the installable PWA. No defaults — set your own.
# APP_NAME: full title (page title, header, install steps, push title, manifest "name").
APP_NAME=Ward Announcements
# APP_SHORT_NAME: home-screen icon label (manifest "short_name"; keep it short, ~12 chars).
APP_SHORT_NAME=Ward
# APP_DESCRIPTION: one-line summary (manifest "description" + page meta description).
APP_DESCRIPTION=Current ward announcements with weekly notifications.
# APP_FOOTER (optional): an audience note in the public page's footer, plain text. The footer always
# ends with the fixed "not an official service of the Church" disclaimer, so don't repeat it here.
APP_FOOTER=Intended for members and friends of the Example 2nd Ward.
# LINK_TEXT / LINK_URL (optional): show a single link below the announcements on the public page
# (e.g. back to the ward's Google Site). Both must be set, or nothing is shown.
# LINK_TEXT=Visit the ward website
# LINK_URL=https://sites.google.com/view/your-ward

# --- Web Push (VAPID) ---
# Optional: leave both blank and a keypair is generated on first boot and kept in the database. To
# pin your own, run `npm run vapid` and set both. Changing the keys later invalidates every
# existing subscription; installed apps re-subscribe on their next launch, browser tabs do not.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services may use. mailto: or https:; blank = PUBLIC_ORIGIN.
VAPID_SUBJECT=mailto:admin@example.org
# Optional: seals the push keys inside the dashboard's backup (32 random bytes, base64url —
# `npm run vapid` prints one). Set, a backup restored here keeps every subscription and the file
# alone cannot send; unset, the backup leaves the keys out and a restore to a fresh database
# re-keys the ward. Keep it with the other secrets, and keep it the same across redeploys.
# BACKUP_SEAL_KEY=

# --- Admin ---
# Password for the /admin login. Use a strong value.
# This also signs the admin session cookie, so changing it ends any open admin session. It does
# NOT affect members — their access cookie has its own key, kept in the database. Pick a long
# passphrase of your own (12+ characters); the app refuses well-known example values.
ADMIN_PASSWORD=
# Everyone else (editors, other admins) signs in with their own passkey: add them from the
# dashboard's Settings tab → People. There is no second password.

# --- Member access gate ---
# Nothing to configure here. The gate is always on: the first code is minted when the app first
# starts, and codes are rotated and the locked page worded from the admin dashboard's Access Code
# card (Settings). The codes live in the database.

# --- Server ---
PORT=3000

# Behind a reverse proxy that provides HTTPS (the usual production setup), set this so rate limits
# key on the client address the proxy saw (the last X-Forwarded-For entry). Leave it unset only when
# nothing is in front of the app, and keep the app's port unreachable except through the proxy.
# TRUST_PROXY=1
# Set to "production" in deployment. Enables Secure cookies and makes PUBLIC_ORIGIN required.
# Production only: it needs an https PUBLIC_ORIGIN, so with it on, `npm run dev` would not start.
# NODE_ENV=production
# SQLite file. In production point this at a persistent volume, e.g. /data/app.db
DATABASE_PATH=./data/app.db
# UPLOADS_PATH (optional): directory for images attached to announcements. Defaults to an
# "uploads" directory beside DATABASE_PATH (e.g. /data/uploads), so the persistent volume that
# holds the database holds the images too. Set it only if they must live somewhere else — and
# then back up both. Node only; on Cloudflare Workers images go to the R2 bucket bound as IMAGES,
# or into D1 itself when no bucket is bound (the Deploy button's template binds none).
# UPLOADS_PATH=/data/uploads
# REQUIRED in production: absolute https origin. Used to build absolute notification URLs, which
# Declarative Web Push needs to navigate correctly on iOS 18.4+ (the primary audience). Boot fails
# if NODE_ENV=production and this is missing or not https. Omit only for local http/localhost dev:
# production only, since passkeys and share links are tied to it and would point away from localhost
# (leave both commented out for the local quick start).
# PUBLIC_ORIGIN=https://announcements.example.org

# --- Scheduling ---
# Timezone for the weekly send. The send day & time are configured in the admin UI
# (default: Sundays at 08:00).
TZ=America/Denver
# How many subscribers one drain of the send queue delivers to. A send is queued and drained in
# chunks; on Node the chunks run back to back until the queue is empty, so this rarely matters.
# The default (12) is sized for the Cloudflare Workers free plan's 10 ms of CPU per invocation.
# At most 90: one chunk's ids go in a single query, and D1 binds at most 100 values per query.
# PUSH_CHUNK_SIZE=12
